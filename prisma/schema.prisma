generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?   // NextAuth standard field (Google OAuth avatar)
  avatar        String?   // Custom display avatar
  bio           String?
  role          String    @default("USER")  // ADMIN, SELLER, USER
  isSeller      Boolean   @default(false)
  password      String?   // For credential-based auth (hashed)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products             Product[]
  reviews              Review[]
  reports              Report[]
  accounts             Account[]
  sessions             Session[]
  sellerApplication    SellerApplication?
  notifications        Notification[]
  purchases            Purchase[]
  analyticsEvents      AnalyticsEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String  // oauth, email
  provider          String  // google, credentials
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  icon     String?
  order    Int      @default(0)
  products Product[]
}

model Product {
  id           String    @id @default(cuid())
  title        String
  description  String
  price        Float     @default(0)
  isFree       Boolean   @default(false)
  format       String
  categorySlug String
  category     Category  @relation(fields: [categorySlug], references: [slug])
  thumbnail    String
  videoUrl     String?
  duration     String?
  views        Int       @default(0)
  sales        Int       @default(0)
  rating       Float     @default(0)
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id])
  tags         String
  featured     Boolean   @default(false)
  published    Boolean   @default(false)  // Only true when reviewStatus=APPROVED
  reviewStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED — new products need review
  reviewNote   String?   // Admin note (rejection reason, etc.)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reviews      Review[]
  files        ProductFile[]
  purchases    Purchase[]
  analyticsEvents AnalyticsEvent[]
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String   // PAGE_VIEW or PRODUCT_VIEW
  visitorId  String
  path       String
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  referrer   String?
  userAgent  String?
  device     String?
  browser    String?
  country    String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([productId, createdAt])
  @@index([visitorId, createdAt])
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String   // Original name at upload time: "TapeDrift_v1.2.zip"
  filePath  String   // Storage key/path: "files/abc123.zip"
  fileSize  Int      // bytes
  fileType  String   // extension: "zip" | "lua" | "jsfx" | "py" | "ReaperConfigZip"
  version   String?  // semantic version: "1.2.0"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  price     Float    // Snapshot of price at purchase time
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // 1 user buys 1 product once (re-download freely)
  @@index([userId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  type        String   // PRODUCT, USER, REVIEW
  targetId    String   // ID of reported entity
  reason      String   // SPAM, INAPPROPRIATE, COPYRIGHT, OTHER
  description String?  // Additional details from reporter
  status      String   @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTIONED
  adminNote   String?  // Admin's note on resolution
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SellerApplication {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String   // Shop name / Seller display name
  bio             String?  // Short description of what they sell
  portfolioUrl    String?  // Portfolio / website URL
  categories      String?  // Comma-separated categories they want to sell in
  reason          String?  // Why they want to become a seller
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote       String?  // Admin's note on decision
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  userId     String   // Who receives this notification
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // SELLER_APPROVED, SELLER_REJECTED, PRODUCT_APPROVED, PRODUCT_REJECTED, NEW_SALE, NEW_REVIEW, SYSTEM
  title      String   // Short title
  message    String   // Detail message
  link       String?  // Optional URL to navigate to when clicked
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])           // Fast lookup by user
  @@index([userId, read])     // Fast unread count query
}
