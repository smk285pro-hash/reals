# Production (VPS stem.reals.media — frontend Next.js + backend FastAPI cùng máy)
# Baked into the client bundle at build time
NEXT_PUBLIC_MAIN_APP_URL=https://reals.media
# Trống = same-origin qua rewrite /api/* → backend 127.0.0.1:3031 (next.config.ts)
NEXT_PUBLIC_API_URL=
BACKEND_API_URL=http://127.0.0.1:3031
