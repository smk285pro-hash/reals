# Production — backend chạy trên Modal serverless (GPU T4):
# https://smk285pro--ai-audio-lab-fastapi-web.modal.run
# Bake vào client bundle lúc build (Vercel) — SPA gọi THẲNG Modal (cross-origin,
# CORS đã mở trên Modal). Đổi URL nếu re-deploy Modal workspace khác.

# Main-app reals.media — nguồn đăng nhập SSO + cấp bridge token
NEXT_PUBLIC_MAIN_APP_URL=https://reals.media

# Backend FastAPI trên Modal (auth: Authorization Bearer bridge token)
NEXT_PUBLIC_API_URL=https://smk285pro--ai-audio-lab-fastapi-web.modal.run

# KHÔNG dùng khi NEXT_PUBLIC_API_URL đã set (rewrite same-origin chỉ dành cho
# phương án self-host VPS — xem .env.example)
