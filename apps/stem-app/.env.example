# AI Audio Lab Studio 2026 (stem-app) — Environment Configuration
#
# Frontend (Next.js) đọc NEXT_PUBLIC_*, backend (FastAPI) đọc phần dưới.
# File này là mẫu: copy thành .env.local (dev) và chỉnh theo nhu cầu.

# ---- Frontend (Next.js, bake vào bundle lúc build) ----
# Main-app reals.media — nguồn đăng nhập SSO + cấp bridge token.
# Dev: http://localhost:3000 (main-app chạy ở đó); production: https://reals.media
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# Để TRỐNG trong kiến trúc monorepo: API call đi same-origin qua rewrite
# của next.config.ts (/api/* → BACKEND_API_URL) → không cần CORS.
# Chỉ set khi muốn gọi thẳng backend cross-origin (ví dụ NEXT_PUBLIC_API_URL=http://127.0.0.1:3031).
NEXT_PUBLIC_API_URL=

# Đích của rewrite /api/* (server-side, không bake vào bundle).
# Dev: backend FastAPI local. Production VPS: backend chạy cùng máy → 127.0.0.1:3031.
BACKEND_API_URL=http://127.0.0.1:3031

# ---- Backend (FastAPI — đặt trong backend/.env hoặc env systemd) ----
APP_PORT=3031
STORAGE_DIR=../storage
MAX_UPLOAD_MB=100
SAMPLE_RATE=44100
LUFS_TARGET=-14.0
SSE_POLL_SECONDS=0.4

# SSO: main-app để verify bridge token + ghi quota (app/core/reals_auth.py)
REALS_MAIN_APP_URL=http://localhost:3000
# REALS_AUTH_CACHE_TTL=60      # giây; 0 = tắt cache verify
# REALS_AUTH_TIMEOUT=5         # timeout HTTP tới main-app (giây)
# CORS backend FastAPI (mặc định đã gồm :3000/:3100/stem.reals.media)
# REALS_ALLOWED_ORIGINS=https://stem.reals.media,https://reals.media
